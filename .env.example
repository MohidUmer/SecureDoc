# Copy to .env and fill values. Never commit .env.

FLASK_ENV=development
SECRET_KEY=change-me-to-long-random-hex
SESSION_TIMEOUT_MINUTES=30

# SQLite (default) — path relative to instance folder
DATABASE_URI=sqlite:///securedoc.db

# Master key for Fernet encryption of document blobs (generate once):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: production HTTPS
# FLASK_ENV=production

# Rate limiting storage (memory default)
# RATELIMIT_STORAGE_URL=memory://
